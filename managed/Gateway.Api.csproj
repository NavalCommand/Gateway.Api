<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.4" />
  </ItemGroup>
  <Target Name="CanonicalCodegen" BeforeTargets="BeforeCompile">
    <Error Condition="'$(Protoc)' == ''" Text="Pass pinned source-built Protoc path." />
    <MakeDir Directories="$(IntermediateOutputPath)generated" />
    <Exec Command="&quot;$(Protoc)&quot; --proto_path=&quot;$(MSBuildProjectDirectory)/../proto&quot; --csharp_out=&quot;$(IntermediateOutputPath)generated&quot; &quot;$(MSBuildProjectDirectory)/../proto/navalcommand/gateway/v1/session.proto&quot; &quot;$(MSBuildProjectDirectory)/../proto/navalcommand/gateway/v1/orders.proto&quot; &quot;$(MSBuildProjectDirectory)/../proto/navalcommand/gateway/v1/world.proto&quot; &quot;$(MSBuildProjectDirectory)/../proto/navalcommand/gateway/v1/incidents.proto&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)generated/*.cs" />
    </ItemGroup>
  </Target>
</Project>
