<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RequiresManagedContext>true</RequiresManagedContext>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.4" GeneratePathProperty="true" />
  </ItemGroup>
  <Target Name="CanonicalCodegen" BeforeTargets="BeforeCompile">
    <Error Condition="'$(Protoc)' == ''" Text="Configure CMake to resolve the pinned source-built protoc." />
    <MakeDir Directories="$(IntermediateOutputPath)generated/v2" />
    <Exec Command="&quot;$(Protoc)&quot; --proto_path=&quot;$(MSBuildProjectDirectory)/../proto&quot; --csharp_out=&quot;$(IntermediateOutputPath)generated/v2&quot; &quot;$(MSBuildProjectDirectory)/../proto/navalcommand/gateway/v2/domain.proto&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)generated/v2/*.cs" />
    </ItemGroup>
  </Target>
</Project>
